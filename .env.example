# Ocean.io API Key
OCEAN_API_KEY=your_ocean_api_key_here

# Prospeo API Key (used for Stage 2 AND Stage 3 email enrichment)
PROSPEO_API_KEY=your_prospeo_api_key_here

# Brevo API Key (from app.brevo.com/settings/keys/api)
BREVO_API_KEY=your_brevo_api_key_here

# Your sender email — must be a verified sender in Brevo
SENDER_EMAIL=you@yourdomain.com
SENDER_NAME=Your Name

# Pipeline controls
MAX_LOOKALIKES=5
MAX_CONTACTS_PER_COMPANY=2
